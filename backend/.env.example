# ==============================================================================
# SmartCart AI - Production Environment Variables Template
# Copy this file to '.env' and populate with your credentials.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

PROJECT_NAME="SmartCart AI - Autonomous Retail Backend"
VERSION="1.0.0"

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon / SQLite)
# ------------------------------------------------------------------------------
# For Supabase (Connection Pooling URL with SSL):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
#
# For Neon Free Tier:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require"
#
# For Supabase Direct or Pooling URL:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.hpuktolsnetlwotihkap.supabase.co:5432/postgres?sslmode=require"


# ------------------------------------------------------------------------------
# 2. SECURITY & JWT TOKENS
# ------------------------------------------------------------------------------
# Secret key used for signing staff JWT bearer tokens
SECRET_KEY="smartcart-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Secret key used for HMAC-SHA256 signing of Cart Handle QR Connect URLs
QR_SIGNING_SECRET="smartcart-qr-hmac-secret-key-production-2026"

# ------------------------------------------------------------------------------
# 3. PUBLIC URLS & CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Public Frontend URL (Used for generating shopper QR links & email receipts)
# In production, set to your Vercel or Netlify HTTPS URL: https://smartcart.vercel.app
BASE_URL="http://localhost:5173"

# Public Backend API URL (Used for WebSockets: wss://... and image uploads)
# In production, set to your Render or Railway HTTPS URL: https://smartcart-api.onrender.com
API_BASE_URL="http://localhost:8000"

# Allowed CORS Origins (comma-separated or * for wildcard)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,*"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (TEST / SANDBOX MODE ONLY)
# ------------------------------------------------------------------------------
PAYMENT_MODE="TEST"
PAYMENT_KEY_ID="rzp_test_smartcart2026"
PAYMENT_KEY_SECRET="rzp_test_secret_mock_sandbox"

# ------------------------------------------------------------------------------
# 5. AI VISION & VERIFICATION THRESHOLDS
# ------------------------------------------------------------------------------
# Auto-approve threshold (>= 85% match: instant verified status)
CONFIDENCE_HIGH=0.85
# Warning threshold (65% - 84%: prompt customer to adjust item)
CONFIDENCE_MEDIUM=0.65
# Escalation threshold (< 65%: route to staff admin review queue)
CONFIDENCE_LOW=0.50
